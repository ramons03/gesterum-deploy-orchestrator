{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Jwt": {
    "Issuer": "gesterum-orchestrator",
    "Audience": "gesterum-operators",
    "Key": "CHANGE_ME_MIN_32_CHARS_SECRET_KEY",
    "ExpirationMinutes": 120
  },
  "Cloudflare": {
    "ApiToken": "",
    "ZoneId": "",
    "DryRun": true
  },
  "Aws": {
    "Region": "us-east-1",
    "DryRun": true
  },
  "Nginx": {
    "DryRun": true,
    "Mode": "local",
    "SshHost": "",
    "SshPort": 22,
    "SshUser": "",
    "SshPassword": ""
  },
  "DeployTemplates": {
    "DryRun": true,
    "DefaultHost": "127.0.0.1"
  },
  "Jobs": {
    "RequireApprovalForDangerousActions": true,
    "DataSource": "Data Source=data/orchestrator.db"
  },
  "EnvironmentApproval": {
    "RequireApprovalInStaging": false,
    "RequireApprovalInProduction": true
  },
  "AllowedHosts": "*"
}
