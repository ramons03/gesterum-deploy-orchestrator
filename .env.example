# Auth
AUTH__ENABLED=false
AUTH__APIKEY=

# Cloudflare
CLOUDFLARE__APITOKEN=
CLOUDFLARE__ZONEID=
CLOUDFLARE__DRYRUN=true

# AWS
AWS__REGION=us-east-1
AWS__DRYRUN=true

# Nginx
NGINX__DRYRUN=true
NGINX__MODE=local
NGINX__SSHHOST=
NGINX__SSHPORT=22
NGINX__SSHUSER=
NGINX__SSHPASSWORD=

# Deploy templates
DEPLOYTEMPLATES__DRYRUN=true
DEPLOYTEMPLATES__DEFAULTHOST=127.0.0.1

# Jobs
JOBS__REQUIREAPPROVALFORDANGEROUSACTIONS=true
JOBS__DATASOURCE=Data Source=data/orchestrator.db

# Environment approvals
ENVIRONMENTAPPROVAL__REQUIREAPPROVALINSTAGING=false
ENVIRONMENTAPPROVAL__REQUIREAPPROVALINPRODUCTION=true
